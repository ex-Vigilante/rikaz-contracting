---
import { href } from '../lib/i18n';
const to = href('ar');
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>رِكاز للمقاولات</title>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body><a href={to}>رِكاز للمقاولات</a></body>
</html>
